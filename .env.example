# Copier en .env (facultatif) ou définir dans l'hébergeur. Aucune valeur secrète n'est requise.
PORT=8080
HOST=0.0.0.0
STATIC_DIR=dist/public
# Dossier de sauvegarde des salons (vide = pas de sauvegarde, salons perdus au redémarrage)
DATA_DIR=data
# Origines autorisées pour le WebSocket, séparées par des virgules (vide = toutes)
ALLOWED_ORIGINS=
# 1 derrière un proxy/load balancer, pour la limitation par IP
TRUST_PROXY=0
# Limite de créations/jonctions de salon par IP et par minute
JOIN_RATE_PER_MIN=15
# Fichier JSON de questions supplémentaires gardées côté serveur (facultatif)
EXTRA_QUESTIONS=
